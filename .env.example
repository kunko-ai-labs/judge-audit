# judge-audit credentials. Copy to .env (git-ignored) or to ~/.config/judge-audit/env.
# Load in a shell with:  set -a; source .env; set +a
# Fill only the ones you have; the CLI reads them from the environment, never from this file.

# --- Gemini (Google AI Studio → API keys) — --judge llm through Google's OpenAI-compatible endpoint:
#     LLM_PROVIDER=openai-compatible LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_API_KEY=$GEMINI_API_KEY LLM_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=

# --- Anthropic (console.anthropic.com) — --judge llm with the official SDK (pip install 'kunko-judge-audit[anthropic]')
#     LLM_PROVIDER=anthropic LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- OpenAI — --judge llm: LLM_PROVIDER=openai-compatible LLM_BASE_URL=https://api.openai.com/v1 LLM_API_KEY=$OPENAI_API_KEY
OPENAI_API_KEY=

# --- Any other hosted platform: write a small provider module (see "custom" in src/judge_audit/judges/llm.py)
#     LLM_PROVIDER=custom LLM_PROVIDER_MODULE=~/.config/judge-audit/providers/<platform>.py
#     LLM_MODEL=<platform model id> LLM_MODEL_LABEL=<name shown in reports>

# --- Codiv (codiv.ai, free tier) hosts OpenJev — --judge jev with JEV_BACKEND=typesafe JEV_ENDPOINT=https://api.codiv.ai/v1/systemone
#     TYPESAFE_API_KEY=$CODIV_API_KEY JEV_NAME=openjev
CODIV_API_KEY=

# --- TypeSafe Jev itself: Vercel AI Gateway (default backend) or the direct API (JEV_BACKEND=typesafe)
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=

# --- Local models through Ollama need nothing:
#     LLM_PROVIDER=openai-compatible LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=llama3.2:3b
